
GIT_USER_EMAIL="your.email@example.com"
GIT_USER_NAME="Your Name"
GITHUB_BRANCH=main
GITHUB_REPO_URL=https://github.com/yourusername/yourrepo.git
# GITHUB_TOKEN=your_github_personal_access_token
# Optional: Use GitHub Personal Access Token for authentication


BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
# Backup Configuration

DATABASES="database1,database2"
# Example: DATABASES="database1,database2,database3"
# Databases to backup (comma-separated list)

MYSQL_PASSWORD=your_mysql_password
MYSQL_USER=your_mysql_user
MYSQL_PORT=3306
MYSQL_HOST=localhost

